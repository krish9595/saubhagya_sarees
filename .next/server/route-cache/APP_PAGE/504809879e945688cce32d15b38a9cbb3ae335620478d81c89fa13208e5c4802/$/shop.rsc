=80","bannerImage":null,"parentId":null,"displayOrder":7,"isActive":true,"seoTitle":"Festive Ethnic Wear Collection | Saubhagya Sarees","seoDescription":"Celebrate Indian festivals in timeless sarees, suits and festive lehengas.","createdAt":"$D2026-11-10T17:52:28.050Z","updatedAt":"$D2026-11-10T18:44:08.006Z"},{"id":"cmwazmlxv001kunv1yxjhv0up","name":"New Arrivals","slug":"new-arrivals","description":"Fresh drops directly from our Hisar bridal studio featuring season-exclusive handlooms and designs.","image":"https://images.unsplash.com/photo-1604309232579-57b2a96dc946?auto=format&fit=crop&w=1000&q=80","bannerImage":null,"parentId":null,"displayOrder":8,"isActive":true,"seoTitle":"New Arrivals Ethnic Wear | Saubhagya Sarees & Bridal Studio","seoDescription":"Discover latest saree arrivals, festive suits and bridal additions at Saubhagya Sarees.","createdAt":"$D2026-11-10T17:52:28.052Z","updatedAt":"$D2026-11-10T18:44:08.007Z"}],"pageTitle":"All Ethnic Fashion Collections","pageDescription":"Handcrafted Banarasi silks, royal bridal lehengas, pure organza drapes, and festive suits curated with generational artistry."}]}],"$L1d","$L1e"]}]
