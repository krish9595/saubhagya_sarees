c:["$","div",null,{"className":"min-h-screen flex flex-col bg-ivory","children":[["$","$L1b",null,{}],["$","main",null,{"className":"flex-1","children":["$","$L1c",null,{"initialProducts":[{"id":"cmwazmm2b005punv1qzyum4mt","title":"Rani Pink Kanjeevaram Silk Saree with Pure Gold Zari Border","slug":"rani-pink-kanjeevaram-pure-gold-zari-saree","sku":"SBS-SR-0203","shortDescription":"Heirloom Kanchipuram silk saree in vibrant Rani Pink featuring Korvai weaving and traditional peacock motifs.","description":"Direct from master looms of South India, this Rani Pink Kanjeevaram silk saree is woven with certified pure 2-ply silk and dipped in molten gold zari. Features authentic temple borders and an ornate pallu commemorating eternal prosperity.","price":"24900","mrp":"32000","discountPercent":22,"taxRate":"5","fabric":"Pure Kanchipuram Mulberry Silk with Gold Zari","occasion":"Bridal","primaryColor":"Rani Pink","blouseDetails":"Unstitched matching silk blouse with heavy zari border","sareeLength":"5.5 meters + 0.8 meter blouse","suitComponents":null,"careInstructions":"Dry clean only. Roll with butter paper to safeguard zari lustre.","customizationAvailable":false,"isFeatured":true,"isBestseller":true,"isNewArrival":false,"status":"PUBLISHED","videoUrl":null,"categoryId":"cmwazmlx8001dunv1whs5mw27","collectionId":"cmwazmly0001munv1u1awyqqg","tags":"kanjeevaram saree, rani pink, wedding saree, pure silk, south silk","viewsCount":0,"salesCount":0,"rating":"5","reviewCount":19,"seoTitle":null,"seoDescription":null,"createdAt":"$D2026-11-10T17:52:28.212Z","updatedAt":"$D2026-11-10T19:04:54.804Z","images":[{"id":"cmwb1h1wt000vun8265sn9nsi","productId":"cmwazmm2b005punv1qzyum4mt","url":"https://images.unsplash.com/photo-1617627143750-d86bc21e42bb?auto=format&fit=crop&w=1000&q=80","alt":"Rani Pink Kanjeevaram Silk Saree with Pure Gold Zari Border view 1","displayOrder":0,"isPrimary":true,"createdAt":"$D2026-11-10T18:44:08.046Z"},{"id":"cmwb1h1wu000xun8262nia9lt","productId":"cm