31:["$","$L2f","cmwazmlza002runv1b02tcgzr",{"product":{"id":"cmwazmlza002runv1b02tcgzr","title":"Ethereal Pastel Organza Saree with Hand-Cut Pitta Work","slug":"ethereal-pastel-organza-saree-pitta-work","sku":"SBS-SR-0202","shortDescription":"Powder pink Italian organza saree highlighted with hand-cut gotta patti borders, pearl scalloping, and resham florals.","description":"Drape yourself in modern romance. This sheer, featherlight Italian organza saree features delicate hand-painted pastel blossoms embellished with fine cut-dana, pearls, and soft champagne pitta work along the scalloped hemline. \n\nAn ideal choice for day weddings, sangeet brunches, and celebratory dinners.","price":"12900","mrp":"16500","discountPercent":22,"taxRate":"5","fabric":"Premium Italian Silk Organza","occasion":"Festive","primaryColor":"Powder Pink","blouseDetails":"Raw silk designer embroidered blouse piece","sareeLength":"5.5 meters + 0.9 meter blouse","suitComponents":null,"careInstructions":"Dry Clean Only. Store flat in saree covers.","customizationAvailable":false,"isFeatured":true,"isBestseller":false,"isNewArrival":true,"status":"PUBLISHED","videoUrl":null,"categoryId":"cmwazmlx8001dunv1whs5mw27","collectionId":"cmwazmly2001nunv1tgnxv8tb","tags":"organza saree, pastel pink, gotta patti, day wedding","viewsCount":0,"salesCount":0,"rating":"4.8","reviewCount":9,"seoTitle":null,"seoDescription":null,"createdAt":"$D2026-11-10T17:52:28.102Z","updatedAt":"$D2026-11-10T17:52:28.102Z","images":[{"id":"cmwb1h1w7000bun82ybji0q6z","productId":"cmwazmlza002runv1b02tcgzr","url":"https://images.unsplash.com/photo-1616756141603-6d37d5cde2a2?auto=format&fit=crop&w=1000&q=80","alt":"Ethereal Pastel Organza Saree with Hand-Cut Pitta Work view 1","displayOrder":0,"isPrimary":true,"createdAt":"$D2026-11-10T18:44:08.023Z"},{"id":"cmwb1h1w9000dun820qyvufx5","productId":"cmwazmlza002runv1b02tcgzr","url":"https://images.unsplash.com/photo-1594761253360-2a487accc7bc?auto=format&fit=crop&w=1000&q=80","a