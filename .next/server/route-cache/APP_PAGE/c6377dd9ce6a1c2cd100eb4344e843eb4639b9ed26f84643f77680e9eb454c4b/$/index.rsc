33:["$","$L2f","cmwazmlz0002funv1uoie31ws",{"product":{"id":"cmwazmlz0002funv1uoie31ws","title":"Handwoven Royal Banarasi Katan Silk Saree","slug":"handwoven-royal-banarasi-katan-silk-saree","sku":"SBS-SR-0201","shortDescription":"Pure Katan silk Banarasi saree in deep wine maroon featuring intricate gold kadwa shikargah motifs and a grand pallu.","description":"A masterwork of generational weavers, this authentic Banarasi saree is woven with certified pure mulberry katan silk. The body features intricate kadwa floral jaal in antique gold zari, while the resplendent pallu showcases traditional royal shikargah motifs.\n\nComes with Silk Mark certification and includes an unstitched contrast brocade blouse piece.","price":"18500","mrp":"24000","discountPercent":23,"taxRate":"5","fabric":"Pure Katan Silk with Gold Zari","occasion":"Wedding Guest","primaryColor":"Wine Maroon","blouseDetails":"Unstitched heavy zari brocade blouse piece included","sareeLength":"5.5 meters saree + 0.8 meter blouse piece","suitComponents":null,"careInstructions":"Dry Clean Only. Iron on reverse using low temperature silk setting. Fold along zari creases carefully.","customizationAvailable":false,"isFeatured":true,"isBestseller":true,"isNewArrival":false,"status":"PUBLISHED","videoUrl":null,"categoryId":"cmwazmlx8001dunv1whs5mw27","collectionId":"cmwazmly0001munv1u1awyqqg","tags":"banarasi saree, katan silk, wine saree, zari pallu, bridal saree","viewsCount":0,"salesCount":0,"rating":"4.9","reviewCount":22,"seoTitle":null,"seoDescription":null,"createdAt":"$D2026-11-10T17:52:28.093Z","updatedAt":"$D2026-11-10T17:52:28.093Z","images":[{"id":"cmwb1h1w20007un82opirz66m","productId":"cmwazmlz0002funv1uoie31ws","url":"https://images.unsplash.com/photo-1604309232579-57b2a96dc946?auto=format&fit=crop&w=1000&q=80","alt":"Handwoven Royal Banarasi Katan Silk Saree view 1","displayOrder":0,"isPrimary":true,"createdAt":"$D2026-11-10T18:44:08.019Z"},{"id":"cmwb1h1w40009un82d1imrqft","productId":"cmwazmlz