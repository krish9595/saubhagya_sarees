32:["$","$L2f","cmwazmly3001punv19u7mthhv",{"product":{"id":"cmwazmly3001punv19u7mthhv","title":"Royal Crimson Zardozi Micro-Velvet Bridal Lehenga","slug":"royal-crimson-zardozi-velvet-bridal-lehenga","sku":"SBS-BR-0101","shortDescription":"Regal crimson micro-velvet bridal lehenga hand-embroidered with antique dabka, tilla, and sequins. Paired with dual dupattas.","description":"Step into timeless majesty with the Royal Crimson Zardozi Bridal Lehenga from the Saubhagya Bridal Studio. Crafted from rich micro-velvet, each panel is adorned with intricate mughal jaal motifs, handcrafted dabka, french knots, and gold badla work. \n\nThe ensemble includes a structured lehenga skirt with a 4.2-meter circular flare, an intricately embellished blouse with dori tie-ups, a deep crimson velvet shoulder dupatta, and a lightweight peach tissue veil dupatta with scalloped borders.","price":"68500","mrp":"89900","discountPercent":24,"taxRate":"5","fabric":"Pure Micro Velvet & Silk Organza","occasion":"Bridal","primaryColor":"Crimson Red","blouseDetails":"Padded custom-stitched blouse with antique gold tassels","sareeLength":null,"suitComponents":"Lehenga, Blouse, Velvet Dupatta, Tissue Veil Dupatta","careInstructions":"Dry Clean Only. Preserve wrapped in pure cotton muslin fabric. Avoid spraying perfumes directly on zardozi embellishments.","customizationAvailable":true,"isFeatured":true,"isBestseller":true,"isNewArrival":true,"status":"PUBLISHED","videoUrl":null,"categoryId":"cmwazmlxb001eunv1tct55imu","collectionId":"cmwazmlxx001lunv1z4rqwpjq","tags":"bridal lehenga, wedding, crimson red, velvet lehenga, zardozi, hisar bridal studio","viewsCount":0,"salesCount":1,"rating":"5","reviewCount":14,"seoTitle":null,"seoDescription":null,"createdAt":"$D2026-11-10T17:52:28.059Z","updatedAt":"$D2026-11-10T18:12:43.939Z","images":[{"id":"cmwb1h1vu0003un82n66c6qtl","productId":"cmwazmly3001punv19u7mthhv","url":"https://images.unsplash.com/photo-1610047614301-13c63f00c032?auto=format&fit=cro