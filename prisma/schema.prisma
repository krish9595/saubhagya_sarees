generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// Admin & RBAC
// -------------------------------------------------------------
model User {
  id           String      @id @default(cuid())
  email        String      @unique
  name         String
  passwordHash String
  roleId       String
  role         Role        @relation(fields: [roleId], references: [id])
  isActive     Boolean     @default(true)
  phone        String?
  lastLoginAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  auditLogs    AuditLog[]
  inventoryMovements InventoryMovement[]
  orderStatusUpdates OrderStatusHistory[]
  refundsCreated     Refund[]

  @@index([roleId])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique // e.g. "SUPER_ADMIN", "STORE_MANAGER", "INVENTORY_MANAGER", "ORDER_MANAGER", "CONTENT_MANAGER", "CUSTOMER_SUPPORT"
  displayName String
  description String?
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  slug        String           @unique // e.g. "products:manage", "orders:manage", "inventory:manage", "cms:manage"
  name        String
  description String?
  category    String           @default("General")
  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

// -------------------------------------------------------------
// Customer Management
// -------------------------------------------------------------
model Customer {
  id           String            @id @default(cuid())
  name         String
  email        String?           @unique
  phone        String            @unique
  passwordHash String?
  isGuest      Boolean           @default(false)
  notes        String?           @db.Text
  addresses    CustomerAddress[]
  orders       Order[]
  wishlists    Wishlist[]
  carts        Cart[]
  reviews      Review[]
  couponUsages CouponUsage[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model CustomerAddress {
  id           String   @id @default(cuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  addressType  String   @default("Home") // Home, Work, etc.
  fullName     String
  phone        String
  streetAddress String
  landmark     String?
  city         String
  state        String
  postalCode   String
  country      String   @default("India")
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([customerId])
}

// -------------------------------------------------------------
// Categories & Collections
// -------------------------------------------------------------
model Category {
  id             String    @id @default(cuid())
  name           String
  slug           String    @unique
  description    String?   @db.Text
  image          String?
  bannerImage    String?
  parentId       String?
  parent         Category? @relation("CategoryToSubcategory", fields: [parentId], references: [id], onDelete: SetNull)
  subcategories  Category[] @relation("CategoryToSubcategory")
  displayOrder   Int       @default(0)
  isActive       Boolean   @default(true)
  seoTitle       String?
  seoDescription String?   @db.Text
  products       Product[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([parentId])
  @@index([displayOrder])
}

model Collection {
  id             String    @id @default(cuid())
  name           String
  slug           String    @unique
  tagline        String?
  description    String?   @db.Text
  image          String?
  bannerImage    String?
  isFeatured     Boolean   @default(false)
  isActive       Boolean   @default(true)
  displayOrder   Int       @default(0)
  seoTitle       String?
  seoDescription String?   @db.Text
  products       Product[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// -------------------------------------------------------------
// Products & Variants
// -------------------------------------------------------------
model Product {
  id                   String           @id @default(cuid())
  title                String
  slug                 String           @unique
  sku                  String           @unique
  shortDescription     String?          @db.Text
  description          String           @db.Text
  price                Decimal          @db.Decimal(10, 2)
  mrp                  Decimal          @db.Decimal(10, 2)
  discountPercent      Int              @default(0)
  taxRate              Decimal          @default(0.0) @db.Decimal(5, 2)
  fabric               String?
  occasion             String?          // Bridal, Wedding Guest, Festive, Party, Casual, Reception
  primaryColor         String?
  blouseDetails        String?          // Unstitched, Stitched, Running, Included, Not Included
  sareeLength          String?          // 5.5m + 0.8m blouse
  suitComponents       String?          // Kurta + Pant + Dupatta
  careInstructions     String?          @db.Text
  customizationAvailable Boolean        @default(false)
  isFeatured           Boolean          @default(false)
  isBestseller         Boolean          @default(false)
  isNewArrival         Boolean          @default(true)
  status               String           @default("PUBLISHED") // DRAFT, PUBLISHED, ARCHIVED
  videoUrl             String?
  categoryId           String
  category             Category         @relation(fields: [categoryId], references: [id])
  collectionId         String?
  collection           Collection?      @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  tags                 String?          @db.Text // Comma-separated
  viewsCount           Int              @default(0)
  salesCount           Int              @default(0)
  rating               Decimal          @default(0.0) @db.Decimal(3, 2)
  reviewCount          Int              @default(0)
  seoTitle             String?
  seoDescription       String?          @db.Text
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  images               ProductImage[]
  variants             ProductVariant[]
  inventories          Inventory[]
  cartItems            CartItem[]
  wishlistItems        WishlistItem[]
  orderItems           OrderItem[]
  reviews              Review[]
  attributeValues      ProductAttributeValue[]

  @@index([categoryId])
  @@index([collectionId])
  @@index([status])
  @@index([isFeatured])
  @@index([isBestseller])
  @@index([isNewArrival])
}

model ProductImage {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url          String   @db.Text
  alt          String?
  displayOrder Int      @default(0)
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([productId])
  @@index([displayOrder])
}

model ProductVariant {
  id              String       @id @default(cuid())
  productId       String
  product         Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  title           String       // e.g. "Free Size - Red", "L - Deep Maroon"
  sku             String       @unique
  size            String?      // XS, S, M, L, XL, XXL, Free Size
  color           String?      // Maroon, Crimson, Gold, Teal, Emerald
  colorHex        String?      // #352018
  additionalPrice Decimal      @default(0.0) @db.Decimal(10, 2)
  stockQuantity   Int          @default(10)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  inventories     Inventory[]
  cartItems       CartItem[]
  orderItems      OrderItem[]

  @@index([productId])
}

model ProductAttribute {
  id        String                  @id @default(cuid())
  name      String                  @unique // e.g. "Work Type", "Weave", "Pattern"
  values    ProductAttributeValue[]
}

model ProductAttributeValue {
  id          String           @id @default(cuid())
  attributeId String
  productId   String
  value       String
  attribute   ProductAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  product     Product          @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([attributeId])
  @@index([productId])
}

// -------------------------------------------------------------
// Inventory
// -------------------------------------------------------------
model Inventory {
  id                 String              @id @default(cuid())
  productId          String
  variantId          String?
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant            ProductVariant?     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity           Int                 @default(0)
  reservedQuantity   Int                 @default(0)
  lowStockThreshold  Int                 @default(3)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  movements          InventoryMovement[]

  @@unique([productId, variantId])
  @@index([productId])
  @@index([variantId])
}

model InventoryMovement {
  id            String     @id @default(cuid())
  inventoryId   String?
  inventory     Inventory? @relation(fields: [inventoryId], references: [id], onDelete: SetNull)
  productId     String
  variantId     String?
  changeType    String     // SALE, RESTOCK, ADJUSTMENT, RETURN, DAMAGE, CANCEL_RESTOCK
  quantityDelta Int        // e.g. -1, +5
  balanceAfter  Int
  notes         String?
  createdByUserId String?
  createdByUser   User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt     DateTime   @default(now())

  @@index([productId])
  @@index([changeType])
}

// -------------------------------------------------------------
// Cart & Wishlist
// -------------------------------------------------------------
model Cart {
  id         String     @id @default(cuid())
  customerId String?
  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sessionId  String     @unique // for guest carts
  items      CartItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([customerId])
}

model CartItem {
  id                 String          @id @default(cuid())
  cartId             String
  cart               Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId          String
  product            Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId          String?
  variant            ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity           Int             @default(1)
  customMeasurements String?         @db.Text
  customNotes        String?         @db.Text
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([cartId])
  @@index([productId])
}

model Wishlist {
  id         String         @id @default(cuid())
  customerId String?
  customer   Customer?      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sessionId  String         @unique // guest session
  items      WishlistItem[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([customerId])
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([wishlistId, productId])
  @@index([productId])
}

// -------------------------------------------------------------
// Orders, Checkout & Shipments
// -------------------------------------------------------------
model Order {
  id                  String               @id @default(cuid())
  orderNumber         String               @unique // e.g. "SSB-2026-1001"
  customerId          String?
  customer            Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  guestName           String?
  guestEmail          String?
  guestPhone          String?
  status              String               @default("PENDING") 
  // PENDING, PAYMENT_PENDING, CONFIRMED, PROCESSING, PACKED, SHIPPED, OUT_FOR_DELIVERY, DELIVERED, CANCELLED, RETURNED, REFUNDED
  subtotal            Decimal              @db.Decimal(10, 2)
  discountAmount      Decimal              @default(0.0) @db.Decimal(10, 2)
  taxAmount           Decimal              @default(0.0) @db.Decimal(10, 2)
  shippingAmount      Decimal              @default(0.0) @db.Decimal(10, 2)
  totalAmount         Decimal              @db.Decimal(10, 2)
  paymentMethod       String               @default("RAZORPAY") // RAZORPAY, COD, UPI_DIRECT
  paymentStatus       String               @default("PENDING")  // PENDING, PAID, FAILED, REFUNDED
  paymentId           String?
  couponCode          String?
  customerNotes       String?              @db.Text
  internalAdminNotes  String?              @db.Text
  cancelReason        String?              @db.Text
  shippingAddressJson String               @db.Text // Full structured address snapshot
  billingAddressJson  String?              @db.Text
  awbCode             String?
  courierName         String?
  trackingUrl         String?
  expectedDeliveryDate DateTime?
  deliveredAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  items               OrderItem[]
  statusHistory       OrderStatusHistory[]
  payments            Payment[]
  refunds             Refund[]
  shipments           Shipment[]
  couponUsages        CouponUsage[]

  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id                 String          @id @default(cuid())
  orderId            String
  order              Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId          String
  product            Product         @relation(fields: [productId], references: [id])
  variantId          String?
  variant            ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName        String
  productSku         String
  unitPrice          Decimal         @db.Decimal(10, 2)
  mrp                Decimal         @db.Decimal(10, 2)
  quantity           Int             @default(1)
  totalPrice         Decimal         @db.Decimal(10, 2)
  imageUrl           String?         @db.Text
  customMeasurements String?         @db.Text
  createdAt          DateTime        @default(now())

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus      String?
  toStatus        String
  notes           String?
  updatedByUserId String?
  updatedByUser   User?    @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())

  @@index([orderId])
}

model Payment {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentMethod String
  amount        Decimal  @db.Decimal(10, 2)
  currency      String   @default("INR")
  transactionId String?  @unique
  gatewayOrderId String?
  signature     String?
  status        String   // PENDING, SUCCESS, FAILED, REFUNDED
  rawResponse   String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([orderId])
}

model Refund {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount          Decimal  @db.Decimal(10, 2)
  reason          String?
  status          String   @default("COMPLETED") // REQUESTED, PROCESSING, COMPLETED, REJECTED
  refundGatewayId String?
  createdByUserId String?
  createdByUser   User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([orderId])
}

model Shipment {
  id          String    @id @default(cuid())
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courierName String
  awbCode     String    @unique
  trackingUrl String?
  labelUrl    String?
  status      String    @default("MANIFESTED") // MANIFESTED, IN_TRANSIT, OUT_FOR_DELIVERY, DELIVERED, RTO
  shippedAt   DateTime?
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([orderId])
}

// -------------------------------------------------------------
// Coupons & Promotions
// -------------------------------------------------------------
model Coupon {
  id               String        @id @default(cuid())
  code             String        @unique
  description      String?
  discountType     String        @default("PERCENTAGE") // PERCENTAGE, FIXED
  discountValue    Decimal       @db.Decimal(10, 2)
  minOrderValue    Decimal       @default(0.0) @db.Decimal(10, 2)
  maxDiscount      Decimal?      @db.Decimal(10, 2)
  startsAt         DateTime      @default(now())
  expiresAt        DateTime?
  usageLimit       Int?
  usageCount       Int           @default(0)
  perCustomerLimit Int           @default(1)
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  usages           CouponUsage[]
}

model CouponUsage {
  id              String    @id @default(cuid())
  couponId        String
  coupon          Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  orderId         String
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  discountApplied Decimal   @db.Decimal(10, 2)
  createdAt       DateTime  @default(now())

  @@index([couponId])
  @@index([orderId])
  @@index([customerId])
}

// -------------------------------------------------------------
// Reviews & Ratings
// -------------------------------------------------------------
model Review {
  id               String    @id @default(cuid())
  productId        String
  product          Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId       String?
  customer         Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  authorName       String
  authorEmail      String?
  rating           Int       @default(5)
  title            String?
  comment          String    @db.Text
  verifiedPurchase Boolean   @default(false)
  status           String    @default("APPROVED") // PENDING, APPROVED, REJECTED
  helpfulVotes     Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([productId])
  @@index([status])
}

// -------------------------------------------------------------
// CMS & Store Front Management
// -------------------------------------------------------------
model Banner {
  id           String   @id @default(cuid())
  title        String
  subtitle     String?
  imageDesktop String   @db.Text
  imageMobile  String?  @db.Text
  ctaText      String?
  ctaLink      String?
  badgeText    String?
  position     String   @default("HERO") // HERO, EDITORIAL_BRIDAL, FESTIVE_STRIP, PROMO_GRID
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([position])
  @@index([isActive])
}

model HomepageSection {
  id           String   @id @default(cuid())
  sectionKey   String   @unique // e.g. "announcement_bar", "hero_slider", "bridal_feature", "brand_story", "instagram_feed", "store_location"
  title        String
  subtitle     String?
  contentJson  String   @db.Text
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  updatedAt    DateTime @updatedAt
}

model CmsPage {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  content        String   @db.Text
  seoTitle       String?
  seoDescription String?  @db.Text
  isActive       Boolean  @default(true)
  updatedAt      DateTime @updatedAt
}

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String?
  source       String   @default("FOOTER")
  isActive     Boolean  @default(true)
  subscribedAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String   @db.Text
  type      String   @default("ORDER") // ORDER, INVENTORY, SYSTEM, CUSTOMER
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail String?
  action    String   // CREATE, UPDATE, DELETE, STATUS_CHANGE, LOGIN
  entity    String   // Product, Order, Inventory, Coupon, Setting
  entityId  String?
  details   String?  @db.Text
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([entity])
  @@index([action])
  @@index([createdAt])
}

model StoreSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  group     String   @default("GENERAL") // GENERAL, SHIPPING, PAYMENT, NOTIFICATIONS, SEO
  updatedAt DateTime @updatedAt

  @@index([group])
}
